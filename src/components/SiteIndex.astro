---
const sections = [
  { label: 'Home', href: '/', count: 9 },
  { label: 'Events', href: '/events', count: 12 },
  { label: 'Portraits', href: '/portraits', count: 12 },
  { label: 'Actors', href: '/actors', count: 12 },
];
---

<button class="site-index-dim" data-index-dim aria-label="Close index"></button>

<div class="site-index-panel" data-index-panel>
  <nav class="site-index-tabs">
    <button class="site-index-tab is-active" data-tab="works">Works</button>
    <button class="site-index-tab" data-tab="info">Info</button>
  </nav>

  <ul class="site-index-list" data-panel="works">
    {sections.map((s) => (
      <li>
        <a href={s.href}>
          <span>{s.label}</span>
          <span class="site-index-count">{s.count}</span>
        </a>
      </li>
    ))}
  </ul>

  <div class="site-index-info" data-panel="info" hidden>
    <p>Beto Ruiz Alonso is a Berlin-based photographer specializing in
    portrait, fashion, and event photography.</p>
    <p><a href="/about">About</a></p>
    <p><a href="mailto:info@betoruizalonso.com">info@betoruizalonso.com</a></p>
  </div>
</div>

<style define:vars={{ panelWidth: '480px' }}>
  .site-index-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(var(--panelWidth), 100%);
    background: var(--color-background);
    padding: 56px 48px;
    overflow-y: auto;
    z-index: 30;
    transform: translateX(100%);
    transition: transform 0.35s ease;
  }

  .site-index-panel.is-open {
    transform: translateX(0);
  }

  .site-index-dim {
    position: fixed;
    inset: 0;
    z-index: 25;
    background: rgba(0, 0, 0, 0.45);
    border: none;
    padding: 0;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .site-index-dim[hidden] {
    display: none;
  }

  .site-index-dim.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .site-index-tabs {
    display: flex;
    gap: 20px;
    margin-bottom: 48px;
  }

  .site-index-tab {
    background: none;
    border: none;
    font: inherit;
    font-size: 0.85rem;
    color: var(--color-muted);
    cursor: pointer;
    padding: 0;
  }

  .site-index-tab.is-active {
    color: var(--color-text);
    text-decoration: underline;
  }

  .site-index-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-index-list a {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    font-size: 0.95rem;
    color: var(--color-text);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .site-index-count {
    color: var(--color-muted);
  }

  .site-index-info p {
    font-size: 0.9rem;
    max-width: 40ch;
    margin: 0 0 16px;
  }

  .site-index-info a {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .site-index-panel {
      padding: 40px 24px;
    }
  }
</style>

<style is:global>
  body {
    transition: padding-right 0.35s ease;
  }

  body.index-open {
    padding-right: min(480px, 100vw);
  }
</style>

<script>
  const panel = document.querySelector<HTMLElement>('[data-index-panel]');
  const dim = document.querySelector<HTMLButtonElement>('[data-index-dim]');
  const tabs = document.querySelectorAll<HTMLButtonElement>('.site-index-tab');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');

  const open = () => {
    panel?.classList.add('is-open');
    dim?.classList.add('is-open');
    document.body.classList.add('index-open');
  };

  const close = () => {
    panel?.classList.remove('is-open');
    dim?.classList.remove('is-open');
    document.body.classList.remove('index-open');
  };

  dim?.addEventListener('click', close);
  document.addEventListener('site-index:open', open);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.classList.toggle('is-active', t === tab));
      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== tab.dataset.tab;
      });
    });
  });
</script>
