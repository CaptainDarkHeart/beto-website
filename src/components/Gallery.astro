---
interface Props {
  label: string;
  count?: number;
  sources?: string[];
}

const { label, count = 9, sources: providedSources } = Astro.props;
const urls = providedSources ?? Array.from(
  { length: count },
  (_, i) => `https://picsum.photos/seed/${label}-${i}/900/1200`
);
const images = urls.map((src, i) => ({ src, n: i + 1 }));
---

<div class="viewer" data-count={images.length} data-label={label} data-sources={JSON.stringify(images.map((i) => i.src))}>
  <div class="viewer__stage">
    <div class="viewer__spacer" aria-hidden="true"></div>

    <div class="viewer__frame">
      <img
        class="viewer__image"
        src={images[0].src}
        alt={`${label} 1`}
        loading="eager"
      />
    </div>

    <p class="viewer__counter">
      <span class="viewer__label">{label}</span> - <span class="viewer__index">1</span>/<span>{images.length}</span>
    </p>
  </div>

  <div class="viewer__thumbs">
    <div class="viewer__thumbs-grid">
      {images.map((img) => (
        <button class="viewer__thumb" data-n={img.n}>
          <img src={img.src} alt={`${label} ${img.n}`} loading="lazy" />
        </button>
      ))}
    </div>
  </div>

  <p class="viewer__toggle">
    <button class="viewer__toggle-btn" data-view="index">Index</button>
    &nbsp;&nbsp;—&nbsp;&nbsp;
    <button class="viewer__toggle-btn" data-view="thumbs">Thumbs</button>
  </p>
</div>

<style>
  .viewer {
    padding: 32px 64px 156px;
  }

  .viewer__stage {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: 24px;
  }

  .viewer__spacer {
    grid-column: 1;
  }

  .viewer__frame {
    grid-column: 2;
    position: relative;
    max-height: 70vh;
    background: #f0f0f0;
    display: flex;
    justify-content: center;
    overflow: hidden;
    cursor: pointer;
  }

  .viewer__image {
    max-width: 100%;
    max-height: 70vh;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .viewer__counter {
    position: fixed;
    top: 0;
    left: 0;
    font-size: 0.85rem;
    color: var(--color-muted);
    margin: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: 15;
    white-space: nowrap;
  }

  .viewer__counter.is-visible {
    opacity: 1;
  }

  .viewer__label {
    text-transform: capitalize;
  }

  .viewer__thumbs {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgba(0, 0, 0, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .viewer__thumbs.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .viewer__thumbs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 20px;
    width: min(1100px, 100%);
    max-height: 100%;
    overflow-y: auto;
    cursor: default;
  }

  .viewer__thumb {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .viewer__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  .viewer__thumb:hover img {
    opacity: 1;
  }

  .viewer__toggle {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 24px;
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-muted);
    margin: 0;
  }

  .viewer__toggle-btn {
    background: none;
    border: none;
    font: inherit;
    color: var(--color-muted);
    cursor: pointer;
    padding: 0;
  }

  .viewer__toggle-btn.is-active {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .viewer {
      padding: 24px 24px 56px;
    }

    .viewer__stage {
      grid-template-columns: 1fr;
    }

    .viewer__spacer {
      display: none;
    }

    .viewer__frame {
      grid-column: 1;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.viewer').forEach((viewer) => {
    const count = Number(viewer.dataset.count ?? 1);
    const label = viewer.dataset.label ?? '';
    const sources: string[] = JSON.parse(viewer.dataset.sources ?? '[]');
    const indexEl = viewer.querySelector('.viewer__index');
    const image = viewer.querySelector<HTMLImageElement>('.viewer__image');
    const stage = viewer.querySelector<HTMLElement>('.viewer__stage');
    const thumbs = viewer.querySelector<HTMLElement>('.viewer__thumbs');
    const toggleBtns = viewer.querySelectorAll<HTMLButtonElement>('.viewer__toggle-btn');
    const counter = viewer.querySelector<HTMLElement>('.viewer__counter');
    let current = 1;
    let hideTimer: ReturnType<typeof setTimeout>;

    document.addEventListener('mousemove', (e) => {
      if (!counter || thumbs?.classList.contains('is-open')) return;
      counter.style.transform = `translate(${e.clientX + 16}px, ${e.clientY + 16}px)`;
      counter.classList.add('is-visible');
      clearTimeout(hideTimer);
      hideTimer = setTimeout(() => counter.classList.remove('is-visible'), 800);
    });

    const render = () => {
      if (indexEl) indexEl.textContent = String(current);
      if (image) {
        image.src = sources[current - 1];
        image.alt = `${label} ${current}`;
      }
    };

    const next = () => {
      current = current === count ? 1 : current + 1;
      render();
    };

    const prev = () => {
      current = current === 1 ? count : current - 1;
      render();
    };

    const showView = (view: string) => {
      if (stage) stage.hidden = view !== 'viewer';
      thumbs?.classList.toggle('is-open', view === 'thumbs');
      toggleBtns.forEach((btn) => {
        btn.classList.toggle('is-active', btn.dataset.view === view);
      });
    };

    thumbs?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.viewer__thumb')) return;
      showView('viewer');
    });

    image?.addEventListener('click', (e) => {
      const rect = image.getBoundingClientRect();
      const clickedRight = e.clientX - rect.left > rect.width / 2;
      if (clickedRight) next();
      else prev();
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (thumbs?.classList.contains('is-open')) return;
      if (target.closest('.viewer__image')) return;
      if (target.closest('button, a')) return;
      if (target.closest('[data-index-panel]')) return;
      if (e.clientX < window.innerWidth / 2) prev();
      else next();
    });

    toggleBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.dataset.view === 'index') {
          document.dispatchEvent(new CustomEvent('site-index:open'));
          return;
        }
        showView(btn.dataset.view ?? 'viewer');
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && thumbs?.classList.contains('is-open')) showView('viewer');
    });

    viewer.querySelectorAll<HTMLButtonElement>('.viewer__thumb').forEach((btn) => {
      btn.addEventListener('click', () => {
        current = Number(btn.dataset.n);
        render();
        showView('viewer');
      });
    });

    render();
    showView('viewer');
  });
</script>
